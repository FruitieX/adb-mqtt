[mqtt]
id = "adb-mqtt"
host = "test.mosquitto.org"
port = 1883

# Optional broker credentials; leave out to connect anonymously
# username = "example"
# password = "secret"

# Topic that will be subscribed to. First plus sign will be replaced with device
# id when publishing device updates.
topic = "home/devices/adb/+"

[device]
ip = "1.2.3.4"
name = "Android TV"